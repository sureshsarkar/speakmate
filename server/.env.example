# ───────────── SpeakMate API: copy to server/.env ─────────────
NODE_ENV=development
PORT=5000

# Browser origin(s) of the React app (comma separated). Used for CORS, Socket.IO and email links.
CLIENT_URL=http://localhost:5173
# Set to the number of reverse proxies in front of the API (nginx/Render/Heroku = 1) so rate limits see real client IPs
TRUST_PROXY=0
# Serve ../client/dist from this server (single-service deployment)
SERVE_CLIENT=false

# ───────────── Database ─────────────
# Local:  mongodb://127.0.0.1:27017/speakmate     Atlas: mongodb+srv://user:pass@cluster/speakmate 
MONGODB_URI=mongodb://127.0.0.1:27017/speakmate
# Development only: set true (and leave MONGODB_URI empty) to use a throwaway in-memory MongoDB
USE_MEMORY_DB=false
# Optional. Enables the Socket.IO Redis adapter (needed to run more than one API instance)
REDIS_URL=

# ───────────── Security (REQUIRED in production, min 16 chars each) ─────────────
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_SECRET=change-me-to-a-different-long-random-string
# Block login until the email is verified
REQUIRE_EMAIL_VERIFICATION=false

# First Super Admin, created automatically when no admin exists
SUPER_ADMIN_EMAIL=admin@speakmate.app
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ───────────── Google sign-in (optional; the button is hidden when empty) ─────────────
GOOGLE_CLIENT_ID=

# ───────────── Profile pictures (optional; uploads are disabled when empty) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────── Email (verification + password reset). Without SMTP the links are printed in the server log ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpeakMate <no-reply@yourdomain.com>"

# ───────────── WebRTC: STUN / TURN ─────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN is REQUIRED in production: ~15-20% of users cannot connect peer to peer without it.
# Comma separated, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Option A - coturn with `use-auth-secret` / `static-auth-secret` (recommended, ephemeral per-user credentials)
TURN_SECRET=
TURN_TTL_SECONDS=21600
# Option B - static credentials (hosted TURN providers such as Twilio, Metered, Xirsys)
TURN_USERNAME=
TURN_PASSWORD=

# ───────────── Web Push (optional): npm run gen:vapid ─────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# debug | info | warn | error
LOG_LEVEL=info
