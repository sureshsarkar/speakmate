{
  "name": "speakmate-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpeakMate API, matchmaking and WebRTC signaling server",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:memory": "cross-env USE_MEMORY_DB=true node --watch src/index.js",
    "seed": "node src/seed/run.js",
    "gen:vapid": "node scripts/gen-vapid.js",
    "test": "node --test --test-concurrency=1 test/matchmaker.test.js test/e2e.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.11",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1",
    "redis": "^4.7.1",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.4.0",
    "socket.io-client": "^4.8.4"
  }
}
