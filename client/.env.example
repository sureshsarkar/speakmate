# ───────────── SpeakMate client: copy to client/.env (all optional) ─────────────

# Dev only: where the Vite proxy forwards /api and /socket.io
VITE_PROXY_TARGET=http://localhost:5000

# Production when the API lives on a different origin than the static site (otherwise leave empty)
# API calls go to  ${VITE_API_URL}/api  and Socket.IO connects to VITE_SOCKET_URL
VITE_API_URL=
VITE_SOCKET_URL=
